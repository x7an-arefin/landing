---
/** Demo page section wrapper: title + the Relume category it maps to. */
const { title, relume } = Astro.props;
---
<section class="mb-14">
  <div class="flex flex-wrap items-baseline gap-3 mb-4">
    <h2 class="text-2xl font-bold tracking-tight">{title}</h2>
    <span class="text-xs opacity-50">maps to Relume: {relume}</span>
  </div>
  <div class="rounded-box bg-base-200/40 p-6">
    <slot />
  </div>
</section>
