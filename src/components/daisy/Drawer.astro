---
/**
 * Drawer — daisyUI 5 exact structure (llms.txt → Drawer):
 * .drawer > input.drawer-toggle + .drawer-content + .drawer-side. Zero JS —
 * labels flip the checkbox. `lg:drawer-open` pins the sidebar on desktop.
 * Mirrors Relume's sidebars (9) and application-shells (16).
 */
const uid = `drawer-${Math.random().toString(36).slice(2, 8)}`;
---
<div class="drawer lg:drawer-open min-h-[50vh]">
  <input id={uid} type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex flex-col">
    <div class="flex items-center justify-between border-b border-base-300 p-4">
      <span class="font-semibold">Main content</span>
      <label for={uid} class="btn btn-ghost btn-circle drawer-button lg:hidden" aria-label="open sidebar">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block size-5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </label>
    </div>
    <div class="p-6 text-sm opacity-80">
      <slot name="content">
        Mobile: the whole page slides behind the sidebar. Desktop: the sidebar is
        pinned — the application-shell anatomy seen in Relume's screenshots.
      </slot>
    </div>
  </div>
  <div class="drawer-side">
    <label for={uid} aria-label="close sidebar" class="drawer-overlay"></label>
    <ul class="menu p-4 w-64 min-h-full bg-base-100 text-base-content">
      <li class="menu-title">Sidebar</li>
      <li><a class="menu-active">Overview</a></li>
      <li><a>Dashboard</a></li>
      <li><a>Projects</a></li>
      <li><a>Settings</a></li>
    </ul>
  </div>
</div>
