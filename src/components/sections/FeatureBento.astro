---
/**
 * FeatureBento — reproduces Relume's `feature-sections-grid-cards` (53,
 * all flagged `bento`).
 *
 * Verified from contact sheets 2026-09-22 (all static). Anatomy: a small
 * "Heading goes here" (optionally centered) above an asymmetric bento grid
 * of cards — mixed sizes (a dominant 2×2 image/text card + 2×2 or rows of
 * smaller cards), each card = image placeholder, or icon + short heading +
 * text, or heading + text. Light page / dark full-bleed tone.
 *
 * `layout` presets a–f map to the six observed arrangements.
 * Zero JS; semantic colors only.
 */
interface Props {
  tone?: 'light' | 'dark';
  align?: 'start' | 'center';
  layout?: 'a' | 'b' | 'c' | 'd' | 'e' | 'f';
  heading?: string;
  subtext?: string;
}
const {
  tone = 'light',
  align = 'start',
  layout = 'a',
  heading = 'Heading goes here',
  subtext = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
} = Astro.props;

const dark = tone === 'dark';
const PHOTO = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-8 opacity-30"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>';
const ICON = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>';

const T1 = 'Medium heading goes here';
const T2 = 'Short heading goes here';
const X = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.';

/** Each preset = list of cards: [role, grid classes] */
type CardDef = { role: 'image' | 'icon' | 'text' | 'big'; cls: string };
const PRESETS: Record<string, CardDef[]> = {
  // dominant 2×2 image card left, 2×2 small cards right
  a: [
    { role: 'image', cls: 'lg:col-span-2 lg:row-span-2 min-h-64' },
    { role: 'icon', cls: 'lg:col-span-1 lg:row-span-1' },
    { role: 'text', cls: 'lg:col-span-1 lg:row-span-1' },
    { role: 'text', cls: 'lg:col-span-1 lg:row-span-1' },
    { role: 'icon', cls: 'lg:col-span-1 lg:row-span-1' },
  ],
  // dominant text card left, mixed right
  b: [
    { role: 'big', cls: 'lg:col-span-2 lg:row-span-2 min-h-64' },
    { role: 'icon', cls: 'lg:col-span-1' },
    { role: 'icon', cls: 'lg:col-span-1' },
    { role: 'text', cls: 'lg:col-span-2' },
    { role: 'image', cls: 'lg:col-span-2' },
  ],
  // 2 tall + mixed rows
  c: [
    { role: 'text', cls: 'lg:col-span-2 min-h-40' },
    { role: 'icon', cls: 'lg:col-span-1' },
    { role: 'image', cls: 'lg:col-span-1' },
    { role: 'icon', cls: 'lg:col-span-1' },
    { role: 'text', cls: 'lg:col-span-2' },
  ],
  // four equal icon cards
  d: [
    { role: 'icon', cls: '' },
    { role: 'icon', cls: '' },
    { role: 'icon', cls: '' },
    { role: 'icon', cls: '' },
  ],
  // image top-right + 3 cards under
  e: [
    { role: 'icon', cls: 'lg:col-span-2 min-h-40' },
    { role: 'image', cls: 'lg:col-span-2 min-h-40' },
    { role: 'text', cls: 'lg:col-span-2' },
    { role: 'icon', cls: 'lg:col-span-1' },
    { role: 'icon', cls: 'lg:col-span-1' },
  ],
  // big bottom + small column right
  f: [
    { role: 'icon', cls: 'lg:col-span-1' },
    { role: 'text', cls: 'lg:col-span-3' },
    { role: 'image', cls: 'lg:col-span-2 min-h-56' },
    { role: 'text', cls: 'lg:col-span-1' },
    { role: 'icon', cls: 'lg:col-span-1' },
  ],
};
const cards = PRESETS[layout] ?? PRESETS.a;
const cardCls = `card rounded-box border p-6 ${dark ? 'border-neutral-content/15 bg-neutral-content/5' : 'border-base-300 bg-base-100'}`;
---
<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-200/40'}>
  <div class="mx-auto max-w-7xl px-4 py-16">
    <div class={`mb-8 ${align === 'center' ? 'text-center' : ''}`}>
      <h2 class={`text-2xl md:text-3xl font-extrabold tracking-tight ${align === 'center' ? 'mx-auto' : ''} max-w-xl`}>{heading}</h2>
      {subtext && <p class={`mt-2 text-sm opacity-70 ${align === 'center' ? 'mx-auto' : ''} max-w-lg`}>{subtext}</p>}
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-fr">
      {cards.map((c) => (
        <div class={`${cardCls} ${c.cls}`}>
          {c.role === 'image' && (
            <div class={`flex h-full min-h-32 items-center justify-center ${dark ? 'bg-neutral-content/10' : 'bg-base-300'}`}><span set:html={PHOTO} /></div>
          )}
          {c.role === 'icon' && (
            <>
              <span set:html={ICON} />
              <h3 class="mt-3 font-bold text-sm">{T2}</h3>
              <p class="mt-1 text-xs opacity-60">{X}</p>
            </>
          )}
          {c.role === 'text' && (
            <>
              <h3 class="font-bold text-sm">{T2}</h3>
              <p class="mt-1 text-xs opacity-60">{X}</p>
            </>
          )}
          {c.role === 'big' && (
            <>
              <h3 class="font-bold">{T1}</h3>
              <p class="mt-2 text-xs opacity-60 max-w-sm">{X} {X}</p>
              <span class="mt-4 inline-flex rounded-btn border border-base-300 px-4 h-9 items-center text-sm opacity-80">Button</span>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
