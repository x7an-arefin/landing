---
/**
 * Comparison — reproduces Relume's `comparison-sections` (15).
 *
 * Patterns supported:
 * 1. Plan headers with prices & CTA buttons.
 * 2. Feature category breakdown with boolean checks or descriptive text.
 * 3. DaisyUI `table table-zebra` with semantic badges & icons.
 * 4. Tone: light | dark.
 *
 * Zero JS; 100% semantic colors.
 */
interface FeatureRow {
  name: string;
  tooltip?: string;
  values: (boolean | string)[];
}

interface FeatureCategory {
  category: string;
  rows: FeatureRow[];
}

interface Props {
  tone?: 'light' | 'dark';
  tagline?: string;
  heading?: string;
  subtext?: string;
  plans?: { name: string; price?: string; description?: string; popular?: boolean }[];
  categories?: FeatureCategory[];
}

const {
  tone = 'light',
  tagline = "Compare Plans",
  heading = "Find the right tier for your team",
  subtext = "Transparent features, no hidden charges. Scale seamlessly as your product grows.",
  plans = [
    { name: "Starter", price: "$19/mo", description: "For solo developers and indie hackers." },
    { name: "Pro", price: "$49/mo", description: "For fast-growing startups and small teams.", popular: true },
    { name: "Enterprise", price: "Custom", description: "Dedicated infrastructure, SLA, and support." }
  ],
  categories = [
    {
      category: "Core Features",
      rows: [
        { name: "All 1,524 Components", values: [true, true, true] },
        { name: "Astro & DaisyUI 5 Source", values: [true, true, true] },
        { name: "Instant 35-Theme Engine", values: [true, true, true] },
        { name: "Client-side JS Included", values: ["Minimal", "Zero-JS", "Custom Built"] },
      ]
    },
    {
      category: "Support & Customization",
      rows: [
        { name: "Community Discord", values: [true, true, true] },
        { name: "Custom Brand Theme Tokens", values: [false, true, true] },
        { name: "Dedicated Engineering SLA", values: [false, false, true] },
        { name: "White-label License", values: [false, false, true] }
      ]
    }
  ]
} = Astro.props;

const dark = tone === 'dark';
const CHECK = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 text-success inline-block"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>';
const CROSS = '<span class="text-base-content/30 font-bold">—</span>';
---

<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      {tagline && <p class="text-xs font-bold uppercase tracking-wider text-primary mb-2">{tagline}</p>}
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h2>
      {subtext && <p class="mt-3 text-sm opacity-70 max-w-2xl mx-auto">{subtext}</p>}
    </div>

    <div class="overflow-x-auto rounded-box border border-base-300">
      <table class="table table-zebra w-full">
        <thead>
          <tr class={dark ? 'bg-neutral-content/10' : 'bg-base-200'}>
            <th class="w-1/3 text-left py-5 px-6 font-bold text-base">Plan Overview</th>
            {plans.map((p) => (
              <th class={`text-center py-5 px-6 ${p.popular ? 'bg-primary/10 relative' : ''}`}>
                {p.popular && (
                  <span class="badge badge-primary badge-xs absolute top-2 right-2 font-bold uppercase">Popular</span>
                )}
                <div class="text-lg font-extrabold">{p.name}</div>
                {p.price && <div class="text-xl font-bold text-primary mt-1">{p.price}</div>}
                {p.description && <p class="text-xs font-normal opacity-70 mt-1">{p.description}</p>}
                <div class="mt-4">
                  <a href="#" class={`btn btn-sm w-full ${p.popular ? 'btn-primary' : 'btn-outline'}`}>
                    Choose {p.name}
                  </a>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {categories.map((cat) => (
            <>
              <tr class={dark ? 'bg-neutral-content/5' : 'bg-base-200/50'}>
                <td colspan={plans.length + 1} class="font-bold text-xs uppercase tracking-wider opacity-70 py-3 px-6">
                  {cat.category}
                </td>
              </tr>
              {cat.rows.map((row) => (
                <tr>
                  <td class="font-medium text-sm py-4 px-6">{row.name}</td>
                  {row.values.map((v) => (
                    <td class="text-center py-4 px-6">
                      {typeof v === 'boolean' ? (
                        v ? <span set:html={CHECK} /> : <span set:html={CROSS} />
                      ) : (
                        <span class="font-semibold text-xs">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
