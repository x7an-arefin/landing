---
/**
 * Team — reproduces Relume's `team-sections` (20).
 *
 * Patterns supported:
 * 1. cols=2 | 3 | 4 column responsive member grid.
 * 2. align="start" | "center" (text alignment and avatar placement).
 * 3. cards=true (bordered card container) vs bare minimal grid.
 * 4. tone="light" | "dark".
 *
 * Zero-JS; semantic DaisyUI colors.
 */
interface TeamMember {
  name: string;
  role: string;
  bio?: string;
  avatar?: string;
  socials?: { platform: string; href: string }[];
}

interface Props {
  cols?: 2 | 3 | 4;
  align?: 'start' | 'center';
  tone?: 'light' | 'dark';
  cards?: boolean;
  tagline?: string;
  heading?: string;
  subtext?: string;
  items?: TeamMember[];
}

const {
  cols = 4,
  align = 'center',
  tone = 'light',
  cards = false,
  tagline = "Our Team",
  heading = "Meet the people behind the platform",
  subtext = "A passionate collective of designers, engineers, and strategists crafting better web tools.",
  items = [
    { name: "Eleanor Vance", role: "Co-Founder & CEO", bio: "Former engineering director with 15+ years in developer tooling." },
    { name: "Devon Reed", role: "CTO & Co-Founder", bio: "Open-source contributor, systems architect, and performance fanatic." },
    { name: "Amara Patel", role: "Head of Product Design", bio: "Crafting intuitive design systems and accessible design primitives." },
    { name: "Liam O'Connor", role: "VP of Engineering", bio: "Scaling web infrastructure and developer productivity worldwide." }
  ],
} = Astro.props;

const dark = tone === 'dark';
const SOCIAL_ICON = '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>';
---

<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class={`mb-14 ${align === 'center' ? 'text-center' : ''}`}>
      {tagline && <p class="text-xs font-bold uppercase tracking-wider text-primary mb-2">{tagline}</p>}
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h2>
      {subtext && <p class={`mt-3 text-sm opacity-70 max-w-2xl ${align === 'center' ? 'mx-auto' : ''}`}>{subtext}</p>}
    </div>

    <div class={`grid gap-8 ${
      cols === 2 ? 'sm:grid-cols-2' : cols === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4'
    }`}>
      {items.map((m) => (
        <div class={`flex flex-col ${align === 'center' ? 'items-center text-center' : 'items-start text-left'} ${
          cards 
            ? `rounded-box p-6 border ${dark ? 'border-neutral-content/15 bg-neutral-content/5' : 'border-base-300 bg-base-100 shadow-sm'}` 
            : ''
        }`}>
          <div class="avatar placeholder mb-4">
            <div class={`size-24 rounded-full ring-2 ring-primary/20 ${
              dark ? 'bg-neutral-content/20 text-neutral-content' : 'bg-base-300 text-base-content'
            }`}>
              <span class="text-xl font-bold">{m.name.split(' ').map(n => n[0]).join('')}</span>
            </div>
          </div>
          <h3 class="text-base font-bold">{m.name}</h3>
          <p class="text-xs font-semibold text-primary mt-0.5">{m.role}</p>
          {m.bio && <p class="mt-2 text-xs opacity-70 leading-relaxed">{m.bio}</p>}
          
          <div class="mt-4 flex gap-2 opacity-60 hover:opacity-100 transition-opacity">
            <a href="#" class="btn btn-ghost btn-circle btn-xs" aria-label="Social link">
              <span set:html={SOCIAL_ICON} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
