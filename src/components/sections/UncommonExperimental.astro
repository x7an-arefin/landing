---
/**
 * UncommonExperimental — reproduces Relume's `uncommon-components` (30),
 * `uncommon-components-2` (37), and `uncommon-components-part-3` (15) = 82 components.
 *
 * Patterns supported:
 * 1. Infinite Horizontal Marquee Strip: Pure CSS continuous ticker with logos & badges.
 * 2. Asymmetric Bento Mosaic: High-contrast bento cards with negative margins and accent highlights.
 * 3. Angled / Overlapping Visual Hero: Diagonal angle polygon backgrounds and sticker badges.
 * 4. High-Density Metric Wall: Floating cards with micro-stats and tags.
 * 5. Tone: light | dark | gradient.
 *
 * Zero external JS (CSS keyframe animations only); 100% semantic DaisyUI 5 tokens.
 */
interface Props {
  tone?: 'light' | 'dark' | 'gradient';
  layout?: 'marquee' | 'bento' | 'angled' | 'stickers';
  tagline?: string;
  heading?: string;
  subtext?: string;
}

const {
  tone = 'light',
  layout = 'marquee',
  tagline = "Experimental & Uncommon Layouts",
  heading = "Pushing the boundaries of pure DaisyUI 5 aesthetics",
  subtext = "High-impact editorial hero treatments, continuous tickers, and asymmetric bento compositions without JavaScript dependencies."
} = Astro.props;

const dark = tone === 'dark';
const uniqueId = `exp-${Math.random().toString(36).substring(2, 8)}`;
---

<section class={`relative overflow-hidden py-16 lg:py-24 ${
  dark ? 'bg-neutral text-neutral-content' :
  tone === 'gradient' ? 'bg-gradient-to-br from-primary/10 via-base-100 to-secondary/10' :
  'bg-base-100 text-base-content'
}`} id={uniqueId}>

  <!-- Layout 1: Infinite Pure CSS Marquee -->
  {layout === 'marquee' && (
    <div>
      <div class="max-w-4xl mx-auto px-4 text-center mb-12">
        {tagline && <span class="badge badge-sm badge-primary uppercase font-bold tracking-wider mb-3">{tagline}</span>}
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight">{heading}</h2>
        <p class={`mt-3 text-sm max-w-xl mx-auto ${dark ? 'text-neutral-content/70' : 'text-base-content/70'}`}>{subtext}</p>
      </div>

      <!-- Marquee Strip Outer -->
      <div class="w-full overflow-hidden border-y border-base-300 py-6 bg-base-200/50 backdrop-blur">
        <div class="flex gap-8 whitespace-nowrap animate-marquee">
          {[1, 2].map(() => (
            <div class="flex items-center gap-8 shrink-0">
              <span class="badge badge-lg badge-primary font-black px-6 py-4 text-sm uppercase tracking-wider">▲ ASTRO 5 READY</span>
              <span class="text-2xl font-black opacity-40">•</span>
              <span class="text-lg font-bold">1,524 DaisyUI Components</span>
              <span class="text-2xl font-black opacity-40">•</span>
              <span class="badge badge-lg badge-secondary font-black px-6 py-4 text-sm uppercase tracking-wider">🎨 35 THEMES</span>
              <span class="text-2xl font-black opacity-40">•</span>
              <span class="text-lg font-bold">Strict Zero Runtime JS</span>
              <span class="text-2xl font-black opacity-40">•</span>
              <span class="badge badge-lg badge-accent font-black px-6 py-4 text-sm uppercase tracking-wider">⚡ 100% LIGHTHOUSE</span>
              <span class="text-2xl font-black opacity-40">•</span>
              <span class="text-lg font-bold">Semantic Tokens Only</span>
              <span class="text-2xl font-black opacity-40">•</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- Layout 2: Asymmetric Bento Mosaic -->
  {layout === 'bento' && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <span class="badge badge-sm badge-secondary uppercase font-bold tracking-wider mb-2">Asymmetric Bento</span>
        <h2 class="text-3xl sm:text-4xl font-black">{heading}</h2>
        <p class="text-sm opacity-70 mt-2">{subtext}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <!-- Spanning Card 1 (7 cols) -->
        <div class={`md:col-span-7 card border rounded-3xl p-8 flex flex-col justify-between overflow-hidden relative shadow-lg ${
          dark ? 'bg-neutral-content/5 border-neutral-content/10' : 'bg-base-200/60 border-base-300'
        }`}>
          <div>
            <div class="badge badge-primary font-bold mb-4">Core Philosophy</div>
            <h3 class="text-2xl sm:text-3xl font-black leading-snug">
              Instant Theming without rewriting CSS classes or rebuilding stylesheets.
            </h3>
            <p class="text-sm opacity-75 mt-3 max-w-lg">
              Every card, border, background, and text token is bound to DaisyUI's semantic CSS variables. Change <code class="font-mono text-primary font-bold">data-theme="..."</code> on the root HTML tag and the entire interface re-skins synchronously with zero layout shift.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-2">
            <span class="badge badge-outline">light</span>
            <span class="badge badge-outline">dark</span>
            <span class="badge badge-outline">cyberpunk</span>
            <span class="badge badge-outline">synthwave</span>
            <span class="badge badge-outline">retro</span>
            <span class="badge badge-outline">+30 more</span>
          </div>
        </div>

        <!-- Spanning Card 2 (5 cols) -->
        <div class={`md:col-span-5 card border rounded-3xl p-8 flex flex-col justify-between shadow-lg ${
          dark ? 'bg-neutral-content/5 border-neutral-content/10' : 'bg-primary text-primary-content border-primary'
        }`}>
          <div>
            <div class="text-4xl mb-4">⚡</div>
            <h3 class="text-2xl font-black leading-tight">Zero-JS Runtime Budget</h3>
            <p class="text-sm opacity-80 mt-2">
              All accordions, tabs, dropdowns, and rating selectors are executed using native HTML checkboxes, details, and CSS pseudos.
            </p>
          </div>
          <div class="mt-6 pt-6 border-t border-primary-content/20 flex items-center justify-between">
            <span class="text-2xl font-black font-mono">0.0 KB</span>
            <span class="text-xs uppercase font-bold tracking-wider opacity-75">Client JS Bundle</span>
          </div>
        </div>

        <!-- Row 2: 3 Balanced Cards (4 cols each) -->
        <div class="md:col-span-4 card border rounded-3xl p-6 bg-base-100 border-base-300 shadow-sm">
          <div class="text-2xl mb-2">🎯</div>
          <div class="font-bold text-lg">1,524 Components</div>
          <p class="text-xs opacity-60 mt-1">Full reproduction of Relume's React components library.</p>
        </div>
        <div class="md:col-span-4 card border rounded-3xl p-6 bg-base-100 border-base-300 shadow-sm">
          <div class="text-2xl mb-2">🛡️</div>
          <div class="font-bold text-lg">100% Semantic Tokens</div>
          <p class="text-xs opacity-60 mt-1">Strict zero-hex design token policy.</p>
        </div>
        <div class="md:col-span-4 card border rounded-3xl p-6 bg-base-100 border-base-300 shadow-sm">
          <div class="text-2xl mb-2">🚀</div>
          <div class="font-bold text-lg">Astro 5 & DaisyUI 5</div>
          <p class="text-xs opacity-60 mt-1">Engineered for modern high-performance SSR and SSG.</p>
        </div>
      </div>
    </div>
  )}

  <!-- Layout 3: Angled Overlapping Visual Hero with Stickers -->
  {layout === 'stickers' && (
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
      <!-- Floating Sticker Badges -->
      <div class="inline-flex items-center gap-2 mb-6">
        <span class="badge badge-primary font-black uppercase tracking-widest text-xs px-3 py-2 shadow-md rotate-[-3deg]">
          ★ 100% COMPLETE
        </span>
        <span class="badge badge-accent font-black uppercase tracking-widest text-xs px-3 py-2 shadow-md rotate-[2deg]">
          68 CATEGORIES
        </span>
        <span class="badge badge-secondary font-black uppercase tracking-widest text-xs px-3 py-2 shadow-md rotate-[-2deg]">
          ZERO BLOAT
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-black tracking-tight max-w-4xl mx-auto leading-[1.08]">
        The ultimate Astro component registry is ready.
      </h1>

      <p class={`mt-4 text-base sm:text-lg max-w-2xl mx-auto ${dark ? 'text-neutral-content/75' : 'text-base-content/75'}`}>
        All 1,524 components crawled, analyzed, mapped to DaisyUI 5 semantic tokens, and organized into reusable sections.
      </p>

      <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
        <a href="/sections" class="btn btn-primary btn-lg shadow-xl">
          Explore All Components
        </a>
        <a href="/" class="btn btn-outline btn-lg">
          Search Directory
        </a>
      </div>
    </div>
  )}
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: flex;
    width: 200%;
    animation: marquee 25s linear infinite;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>
