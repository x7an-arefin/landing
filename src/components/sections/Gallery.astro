---
/**
 * Gallery — reproduces Relume's `gallery-sections` (26).
 *
 * Patterns supported:
 * 1. layout="grid" — 3 or 4-column responsive media grid with hover caption plates.
 * 2. layout="featured" — 1 dominant wide media card + 4 adjacent cards.
 * 3. layout="masonry" — asymmetric height layout with subtle zoom on hover.
 * 4. tone="light" | "dark".
 *
 * Zero JS; pure semantic colors and CSS hover transitions.
 */
interface GalleryItem {
  title?: string;
  category?: string;
  caption?: string;
  aspect?: 'square' | 'video' | 'portrait' | 'wide';
}

interface Props {
  layout?: 'grid' | 'featured' | 'masonry';
  cols?: 3 | 4;
  tone?: 'light' | 'dark';
  heading?: string;
  subtext?: string;
  tagline?: string;
  items?: GalleryItem[];
}

const {
  layout = 'grid',
  cols = 3,
  tone = 'light',
  heading = "Visual Showcase & Gallery",
  subtext = "A curated collection of interfaces, architectures, and design moments.",
  tagline = "Gallery",
  items = [
    { title: "Design Systems", category: "Interface", caption: "Token-based themes & layouts" },
    { title: "Component Registry", category: "Architecture", caption: "1,524 reusable Astro patterns" },
    { title: "Instant Theming", category: "Performance", caption: "Zero-runtime CSS variables" },
    { title: "DaisyUI Primitives", category: "Framework", caption: "Accessible semantic elements" },
    { title: "Responsive Collages", category: "Layout", caption: "Multi-device viewport alignment" },
    { title: "Zero-JS Workflows", category: "Engineering", caption: "HTML5 native behavior" }
  ],
} = Astro.props;

const dark = tone === 'dark';
const CAMERA_ICON = '<svg xmlns="http://www.w3.org/2000/svg" class="size-10 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0ZM18.75 10.5h.008v.008h-.008V10.5Z" /></svg>';
---

<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    {(heading || tagline) && (
      <div class="text-center mb-12">
        {tagline && <span class="badge badge-primary badge-sm font-semibold mb-2">{tagline}</span>}
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{heading}</h2>
        {subtext && <p class="mt-2 text-sm opacity-70 max-w-2xl mx-auto">{subtext}</p>}
      </div>
    )}

    {layout === 'grid' && (
      <div class={`grid gap-6 ${cols === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3'}`}>
        {items.map((item) => (
          <div class="group relative aspect-4/3 overflow-hidden rounded-box bg-base-300 border border-base-300 shadow-sm cursor-pointer">
            <div class="flex h-full w-full items-center justify-center bg-base-200 transition-transform duration-300 group-hover:scale-105">
              <span set:html={CAMERA_ICON} />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex flex-col justify-end p-6 text-white">
              {item.category && <span class="text-xs font-semibold text-primary mb-1 uppercase tracking-wider">{item.category}</span>}
              <h3 class="text-base font-bold text-white">{item.title}</h3>
              {item.caption && <p class="text-xs text-white/80 mt-1">{item.caption}</p>}
            </div>
          </div>
        ))}
      </div>
    )}

    {layout === 'featured' && (
      <div class="grid gap-6 lg:grid-cols-12">
        <div class="group relative aspect-16/10 lg:aspect-auto lg:col-span-8 overflow-hidden rounded-box bg-base-300 border border-base-300 shadow-sm cursor-pointer">
          <div class="flex h-full w-full min-h-72 items-center justify-center bg-base-200 transition-transform duration-300 group-hover:scale-105">
            <span set:html={CAMERA_ICON} />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-90 sm:opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex flex-col justify-end p-8 text-white">
            <span class="text-xs font-semibold text-primary mb-1 uppercase tracking-wider">{items[0]?.category || "Featured"}</span>
            <h3 class="text-2xl font-bold text-white">{items[0]?.title || "Hero Showcase"}</h3>
            <p class="text-sm text-white/80 mt-1">{items[0]?.caption || "Leading design implementation"}</p>
          </div>
        </div>

        <div class="lg:col-span-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-1">
          {items.slice(1, 3).map((item) => (
            <div class="group relative aspect-16/10 overflow-hidden rounded-box bg-base-300 border border-base-300 shadow-sm cursor-pointer">
              <div class="flex h-full w-full items-center justify-center bg-base-200 transition-transform duration-300 group-hover:scale-105">
                <span set:html={CAMERA_ICON} />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 flex flex-col justify-end p-5 text-white">
                <span class="text-xs font-semibold text-primary mb-0.5">{item.category}</span>
                <h4 class="text-sm font-bold text-white">{item.title}</h4>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
