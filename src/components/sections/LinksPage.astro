---
/**
 * LinksPage — reproduces Relume's `links-pages` (16).
 *
 * Patterns supported:
 * 1. layout="centered" — classic mobile-first bio-link stack (avatar + bio + stacked link buttons + socials).
 * 2. layout="grid" — multi-column link hub with category groups and search.
 * 3. tone="light" | "dark".
 *
 * Zero JS; 100% semantic DaisyUI tokens.
 */
interface LinkItem {
  title: string;
  url: string;
  badge?: string;
  featured?: boolean;
}

interface Props {
  layout?: 'centered' | 'grid';
  tone?: 'light' | 'dark';
  profile?: {
    name: string;
    handle: string;
    bio: string;
    avatar?: string;
  };
  links?: LinkItem[];
}

const {
  layout = 'centered',
  tone = 'light',
  profile = {
    name: "Astro DaisyUI Registry",
    handle: "@astro_daisyui",
    bio: "1,524 reusable UI components built with pure Astro & DaisyUI 5. Instant 35-theme swapping."
  },
  links = [
    { title: "Browse Component Gallery", url: "#", badge: "New", featured: true },
    { title: "Theme Switcher & Live Demo", url: "/demo" },
    { title: "GitHub Repository & Documentation", url: "https://github.com" },
    { title: "Join Developer Discord Community", url: "#" },
    { title: "DaisyUI 5 Semantic Cheat Sheet", url: "https://daisyui.com/llms.txt" }
  ]
} = Astro.props;

const dark = tone === 'dark';
const SOCIAL_ICONS = [
  '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>',
  '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>',
  '<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>'
];
---

<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    {layout === 'centered' && (
      <div class="max-w-md mx-auto text-center">
        <div class="avatar placeholder mb-4">
          <div class={`size-24 rounded-full ring-4 ring-primary/20 ${
            dark ? 'bg-neutral-content/20 text-neutral-content' : 'bg-base-300 text-base-content'
          }`}>
            <span class="text-2xl font-extrabold">{profile.name[0]}</span>
          </div>
        </div>

        <h1 class="text-xl font-extrabold">{profile.name}</h1>
        <p class="text-xs font-semibold text-primary mt-0.5">{profile.handle}</p>
        <p class="text-xs opacity-75 mt-2 leading-relaxed">{profile.bio}</p>

        <div class="mt-8 space-y-3">
          {links.map((link) => (
            <a
              href={link.url}
              class={`btn btn-block justify-between rounded-box transition-all hover:scale-[1.01] ${
                link.featured 
                  ? 'btn-primary shadow-sm' 
                  : dark ? 'btn-outline border-neutral-content/20 text-neutral-content hover:bg-neutral-content/10' : 'btn-outline'
              }`}
            >
              <span class="text-sm font-semibold">{link.title}</span>
              {link.badge && <span class="badge badge-sm badge-secondary font-bold">{link.badge}</span>}
            </a>
          ))}
        </div>

        <div class="mt-10 flex justify-center gap-4 opacity-70">
          {SOCIAL_ICONS.map((icon) => (
            <a href="#" class="btn btn-ghost btn-circle btn-sm">
              <span set:html={icon} />
            </a>
          ))}
        </div>
      </div>
    )}

    {layout === 'grid' && (
      <div>
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{profile.name} Resource Hub</h2>
          <p class="mt-2 text-sm opacity-70">{profile.bio}</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
          {links.map((link) => (
            <div class={`rounded-box p-6 border flex flex-col justify-between group hover:border-primary transition-all ${
              dark ? 'border-neutral-content/15 bg-neutral-content/5' : 'border-base-300 bg-base-100 shadow-sm'
            }`}>
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-primary">Resource</span>
                  {link.badge && <span class="badge badge-xs badge-secondary">{link.badge}</span>}
                </div>
                <h3 class="font-bold text-base group-hover:text-primary transition-colors">{link.title}</h3>
              </div>
              <div class="mt-6">
                <a href={link.url} class="btn btn-primary btn-sm btn-block">Visit Resource</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
