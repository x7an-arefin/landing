---
/**
 * LongForm — reproduces Relume's `long-form-content-sections` (32).
 *
 * Verified live 2026-09-22: content5/6 carry the `interaction` flag but the
 * preview DOM is a plain static article (links only) — no state. Anatomy:
 * article heading + 2–3 paragraphs, with an image/video block right, left,
 * below, or as a double stack below; optional row of 4 mini columns;
 * optional "Table of contents" sidebar (heading anchor list) for the
 * content23–32 variants. Light or dark tone.
 *
 * Zero JS; semantic colors only.
 */
interface Props {
  tone?: 'light' | 'dark';
  title?: string;
  paras?: string[];
  media?: { kind?: 'image' | 'video'; side?: 'right' | 'left' | 'below' | 'double-below' } | false;
  minis?: { title: string; text: string }[];
  toc?: string[];
}
const {
  tone = 'light',
  title = 'Short heading goes here',
  paras = [
    'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat.',
    'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla.',
  ],
  media,
  minis = [],
  toc = [],
} = Astro.props;

const dark = tone === 'dark';
const mediaBg = dark ? 'bg-neutral-content/10' : 'bg-base-300';
const PHOTO = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-10 opacity-30"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>';
const PLAY = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 translate-x-0.5"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14Z" /></svg>';

const mediaBlock = (aspect: string) =>
  media?.kind === 'video'
    ? `<div class="relative ${aspect} ${mediaBg} flex items-center justify-center"><span class="absolute size-12 rounded-lg bg-base-100/80 text-base-content flex items-center justify-center">${PLAY}</span></div>`
    : `<div class="${aspect} ${mediaBg} flex items-center justify-center">${PHOTO}</div>`;
---
<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="mx-auto max-w-7xl px-4 py-16">
    {toc.length > 0 ? (
      <!-- TOC variant (content23–32): sidebar of heading anchors + article -->
      <div class="grid gap-12 lg:grid-cols-[220px_1fr]">
        <aside>
          <p class="text-xs font-bold tracking-wide opacity-60">Table of contents</p>
          <ul class="mt-3 space-y-2 text-sm border-l border-base-300/0 pl-4">
            {toc.map((t, i) => (
              <li><a class="opacity-70 hover:opacity-100" href={`#lf-h${i}`}>{t}</a></li>
            ))}
          </ul>
        </aside>
        <article class="max-w-2xl">
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">{title}</h2>
          {paras.map((p, i) => (
            <p class="mt-4 text-sm opacity-75 leading-relaxed" id={`lf-h${i}`}>{p}</p>
          ))}
          {media && media.side !== 'right' && (
            <span class="block mt-8" set:html={mediaBlock('aspect-[16/8]')} />
          )}
        </article>
      </div>
    ) : (
      <div class={`grid items-start gap-12 ${media && (media.side === 'right' || media.side === 'left') ? 'lg:grid-cols-2' : ''}`}>
        <article class={`max-w-2xl ${media?.side === 'left' ? 'order-2' : ''}`}>
          <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">{title}</h2>
          {paras.map((p) => (
            <p class="mt-4 text-sm opacity-75 leading-relaxed">{p}</p>
          ))}
          {minis.length > 0 && (
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {minis.map((m) => (
                <div>
                  <p class="text-xs font-bold">{m.title}</p>
                  <p class="mt-1 text-xs opacity-60">{m.text}</p>
                </div>
              ))}
            </div>
          )}
        </article>
        {media && (media.side === 'right' || media.side === 'left') && (
          <div class={media.side === 'left' ? 'order-1' : ''}>
            <span class="block" set:html={mediaBlock('aspect-[4/3]')} />
          </div>
        )}
      </div>
    )}

    {media && !toc.length && (media.side === 'below' || media.side === 'double-below') && (
      <div class="mt-12 max-w-4xl space-y-6">
        <span class="block" set:html={mediaBlock('aspect-[16/8]')} />
        {media.side === 'double-below' && <span class="block" set:html={mediaBlock('aspect-[16/8]')} />}
      </div>
    )}
  </div>
</section>
