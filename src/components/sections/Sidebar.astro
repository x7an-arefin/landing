---
/**
 * Sidebar — reproduces Relume's `sidebars` (9).
 *
 * Patterns supported:
 * 1. Tree navigation with expandable menu groups.
 * 2. Active pill indicator, notification count badges.
 * 3. User profile card footer with status ring.
 * 4. Workspace selector dropdown.
 * 5. Tone: light | dark.
 *
 * Zero external JS; 100% semantic DaisyUI 5 tokens.
 */
interface Props {
  tone?: 'light' | 'dark';
  compact?: boolean;
}

const {
  tone = 'light',
  compact = false
} = Astro.props;

const dark = tone === 'dark';
---

<div class={`w-full max-w-xs rounded-2xl border border-base-300 p-4 flex flex-col justify-between min-h-[520px] shadow-sm ${
  dark ? 'bg-neutral text-neutral-content' : 'bg-base-100 text-base-content'
}`}>
  <div>
    <!-- Workspace Selector -->
    <div class="dropdown w-full mb-4">
      <div tabindex="0" role="button" class="btn btn-outline btn-sm w-full justify-between font-normal">
        <div class="flex items-center gap-2 truncate">
          <div class="size-5 rounded bg-primary text-primary-content flex items-center justify-center font-bold text-[10px]">
            ⚡
          </div>
          <span class="font-bold text-xs">Production Cluster</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 opacity-60">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </div>
      <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-base-100 rounded-box w-full z-10 text-xs border border-base-300">
        <li><a>⚡ Production Cluster</a></li>
        <li><a>🧪 Staging Preview</a></li>
        <li><a>📦 Local Sandbox</a></li>
      </ul>
    </div>

    <!-- Main Nav -->
    <ul class="menu menu-sm gap-1 p-0">
      <li class="menu-title text-[10px] uppercase font-bold tracking-wider opacity-60">Core Library</li>
      <li>
        <a class="active font-bold flex items-center justify-between">
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
              <path d="M2 4.25A2.25 2.25 0 014.25 2h11.5A2.25 2.25 0 0118 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75H4.25a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h2a.75.75 0 010 1.5h-2A2.25 2.25 0 012 15.75V4.25z" />
            </svg>
            Components
          </span>
          <span class="badge badge-xs badge-primary font-bold">1,524</span>
        </a>
      </li>
      <li>
        <a>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M12.577 4.878a.75.75 0 01.919-.53l4.78 1.281a.75.75 0 01.531.919l-1.281 4.78a.75.75 0 01-1.449-.387l.81-3.022-3.79-1.015a.75.75 0 01-.52-.926z" clip-rule="evenodd" />
          </svg>
          Interactive Templates
        </a>
      </li>
      <li>
        <a>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path d="M10 2a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0v-1.5A.75.75 0 0110 2zM10 15a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0v-1.5A.75.75 0 0110 15z" />
          </svg>
          Theme Generator (35)
        </a>
      </li>

      <li class="menu-title text-[10px] uppercase font-bold tracking-wider opacity-60 mt-4">System Settings</li>
      <li><a>🔑 API Tokens</a></li>
      <li><a>🪝 Webhook Events</a></li>
      <li><a>📜 Audit Logs</a></li>
    </ul>
  </div>

  <!-- User Profile Footer -->
  <div class="pt-4 border-t border-base-300 flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <div class="avatar online">
        <div class="size-8 rounded-full">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=80&q=80" alt="Avatar" />
        </div>
      </div>
      <div>
        <div class="text-xs font-bold leading-tight">Yotech66</div>
        <div class="text-[10px] opacity-60 leading-tight">Lead Engineer</div>
      </div>
    </div>
    <button class="btn btn-ghost btn-xs btn-circle" aria-label="Settings">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path fill-rule="evenodd" d="M8.34 1.804A1 1 0 019.32 1h1.36a1 1 0 01.98.804l.295 1.473c.497.144.971.342 1.416.587l1.25-.834a1 1 0 011.262.125l.962.962a1 1 0 01.125 1.262l-.834 1.25c.245.445.443.919.587 1.416l1.473.294a1 1 0 01.804.98v1.361a1 1 0 01-.804.98l-1.473.295a6.95 6.95 0 01-.587 1.416l.834 1.25a1 1 0 01-.125 1.262l-.962.962a1 1 0 01-1.262.125l-1.25-.834a6.953 6.953 0 01-1.416.587l-.294 1.473a1 1 0 01-.98.804H9.32a1 1 0 01-.98-.804l-.295-1.473a6.957 6.957 0 01-1.416-.587l-1.25.834a1 1 0 01-1.262-.125l-.962-.962a1 1 0 01-.125-1.262l.834-1.25a6.957 6.957 0 01-.587-1.416l-1.473-.294A1 1 0 011 10.68V9.32a1 1 0 01.804-.98l1.473-.295c.144-.497.342-.971.587-1.416l-.834-1.25a1 1 0 01.125-1.262l.962-.962A1 1 0 015.38 3.44l1.25.834c.445-.245.919-.443 1.416-.587l.294-1.473zM13 10a3 3 0 11-6 0 3 3 0 016 0z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>
</div>
