---
/**
 * Cta — reproduces Relume's `cta-sections` (36) and
 * `cta-sections-grid-cards` (18, via contained=true).
 *
 * Verified live 2026-09-21: all static bands (no forms beyond a decorative
 * e-mail join; the logo row is plain images). Families:
 *  - start: heading + text left, actions right or under text (cta 1–26 mix)
 *  - center: centered heading + actions (cta 29–32)
 *  - media: small image right (cta 1–4) or wide media below (cta 25–28)
 *  - email capture: input + Sign Up/Subscribe (cta 5–6, 11–12, 21–24, 32)
 *  - logos: brand logo row under the actions (cta 33–34)
 *  - cols: 3–4 mini columns (short heading + text + button) (cta 35–36)
 *  - dark tone = full-bleed neutral band (or dark card when contained)
 *
 * Zero JS, semantic colors only.
 */
interface Props {
  align?: 'start' | 'center' | 'split';
  tone?: 'light' | 'dark';
  contained?: boolean;
  capture?: 'buttons' | 'email' | 'none';
  /** small image right (cta1–4) */
  media?: 'right' | 'below' | false;
  mediaSrc?: string;
  logos?: string[];
  cols?: { title: string; text: string }[];
  note?: string;
  title?: string;
  text?: string;
}
const {
  align = 'start',
  tone = 'light',
  contained = false,
  capture = 'buttons',
  media = false,
  mediaSrc,
  logos = [],
  cols = [],
  note,
  title = 'Medium length heading goes here',
  text = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique.',
} = Astro.props;

const dark = tone === 'dark';
const centered = align === 'center';
const split = align === 'split';
const bandCls = dark ? 'bg-neutral text-neutral-content' : 'bg-base-200/60';
const PHOTO = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-10 opacity-30"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>';
const LOGO = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5 opacity-60"><path stroke-linecap="round" stroke-linejoin="round" d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>';

// Action row (buttons or e-mail capture) as a string — frontmatter is TS, not TSX.
const ACTIONS =
  capture === 'buttons'
    ? `<div class="flex gap-3 ${centered ? 'justify-center' : ''}">
         <button class="btn ${dark ? 'btn-neutral bg-base-100 text-base-content' : 'btn-neutral'}">Button</button>
         <button class="btn btn-outline">Button</button>
       </div>`
    : capture === 'email'
      ? `<div class="${centered ? 'flex justify-center' : ''}">
           <form class="join">
             <input type="email" placeholder="Enter your email" class="input input-bordered join-item w-56 ${dark ? 'bg-transparent' : ''}" />
             <button class="btn join-item btn-neutral">Sign Up</button>
           </form>
         </div>`
      : '';
const NOTE = note ? `<p class="mt-3 text-xs opacity-50 ${centered ? 'mx-auto' : 'max-w-md'}">${note}</p>` : '';
const CAPTURE_HTML = ACTIONS + NOTE;
---
<section class={contained ? (dark ? 'bg-base-200/40' : 'bg-base-100') : bandCls}>
  <div class={contained ? 'mx-auto max-w-7xl px-4 py-12' : 'mx-auto max-w-7xl px-4 py-14'}>
    <div class={contained
      ? `${dark ? 'bg-neutral text-neutral-content border-neutral-content/15' : 'bg-base-100 border-base-300'} rounded-box p-10`
      : ''}>
      <!-- Mini feature columns (cta 35–36) -->
      {cols.length > 0 ? (
        <div class={`grid gap-8 ${cols.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3'} ${centered ? 'text-center' : ''}`}>
          {cols.map((c) => (
            <div class={centered ? 'mx-auto max-w-xs' : 'max-w-xs'}>
              <h3 class="font-bold">{c.title}</h3>
              <p class="text-sm opacity-60 mt-1">{c.text}</p>
              <button class={`btn btn-sm mt-3 ${dark ? 'btn-neutral bg-base-100 text-base-content' : 'btn-neutral'}`}>Button</button>
            </div>
          ))}
        </div>
      ) : (
        <>
          <div class={`${media === 'right' ? 'grid items-center gap-8 lg:grid-cols-[1fr_280px]' : ''} ${split ? 'flex flex-col md:flex-row md:items-center md:justify-between gap-6' : centered ? 'text-center' : ''}`}>
            <div class={centered ? 'mx-auto max-w-2xl' : ''}>
              <h2 class={`text-3xl md:text-4xl font-extrabold tracking-tight ${centered ? '' : 'max-w-2xl'}`}>{title}</h2>
              <p class={`mt-3 opacity-70 ${centered ? 'mx-auto max-w-xl' : 'max-w-xl'}`}>{text}</p>
              {!split && <div class="mt-6" set:html={CAPTURE_HTML} />}
            </div>
            {split && <div set:html={CAPTURE_HTML} />}
            {media === 'right' && (
              <div class={`aspect-[4/3] ${dark ? 'bg-neutral-content/10' : 'bg-base-300'} flex items-center justify-center`}>
                {mediaSrc ? <img src={mediaSrc} alt="" class="w-full h-full object-cover" /> : <span set:html={PHOTO} />}
              </div>
            )}
          </div>
          {media === 'below' && (
            <div class={`mt-8 ${centered ? 'mx-auto max-w-3xl' : 'max-w-3xl'}`}>
              <div class={`aspect-[16/6] ${dark ? 'bg-neutral-content/10' : 'bg-base-300'} flex items-center justify-center`}>
                {mediaSrc ? <img src={mediaSrc} alt="" class="w-full h-full object-cover" /> : <span set:html={PHOTO} />}
              </div>
            </div>
          )}
          {logos.length > 0 && (
            <div class={`mt-10 flex flex-wrap items-center gap-x-10 gap-y-4 ${centered ? 'justify-center' : ''}`}>
              {logos.map((l) => (
                <span class="flex items-center gap-2 font-semibold opacity-70"><span set:html={LOGO}></span>{l}</span>
              ))}
            </div>
          )}
        </>
      )}
    </div>
  </div>
</section>
