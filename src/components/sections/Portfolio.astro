---
/**
 * Portfolio — reproduces Relume's `portfolio-sections` (17) and
 * `portfolio-headers` (12) = 29 components.
 *
 * Patterns supported:
 * 1. layout="grid" — 2 or 3-column project case study cards with tags & view links.
 * 2. layout="header" — portfolio hero: bold agency headline + category filter chips + featured preview.
 * 3. layout="split" — project narrative left, device mockup / screenshot right.
 * 4. tone="light" | "dark".
 *
 * Zero JS; semantic DaisyUI tokens only.
 */
interface ProjectItem {
  title: string;
  category: string;
  client?: string;
  year?: string;
  description?: string;
  link?: string;
}

interface Props {
  layout?: 'grid' | 'header' | 'split';
  cols?: 2 | 3;
  tone?: 'light' | 'dark';
  tagline?: string;
  heading?: string;
  subtext?: string;
  filters?: string[];
  items?: ProjectItem[];
}

const {
  layout = 'grid',
  cols = 3,
  tone = 'light',
  tagline = "Selected Work",
  heading = "Transformative digital products & design systems",
  subtext = "A showcase of enterprise interfaces, brand experiences, and architectural engineering.",
  filters = ["All", "Web Architecture", "Design Systems", "Mobile Apps", "Fintech"],
  items = [
    {
      title: "Omnichannel Banking Suite",
      category: "Fintech",
      client: "Apex Financial",
      year: "2026",
      description: "Complete design system and component architecture for real-time portfolio management.",
      link: "#"
    },
    {
      title: "Cloud Infrastructure Console",
      category: "Web Architecture",
      client: "Vanguard Systems",
      year: "2026",
      description: "High-density dashboard with zero-latency metric streaming and custom data widgets.",
      link: "#"
    },
    {
      title: "Next-Gen Logistics Platform",
      category: "Design Systems",
      client: "Global Cargo AI",
      year: "2025",
      description: "Responsive web portal with offline caching, interactive maps, and theme personalization.",
      link: "#"
    }
  ]
} = Astro.props;

const dark = tone === 'dark';
const ARROW = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 inline-block transition-transform group-hover:translate-x-1"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>';
---

<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    {layout === 'header' && (
      <div>
        <div class="mb-12 max-w-3xl">
          {tagline && <span class="badge badge-primary badge-sm font-semibold mb-3">{tagline}</span>}
          <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-tight">{heading}</h1>
          {subtext && <p class="mt-4 text-sm opacity-70 leading-relaxed">{subtext}</p>}
          
          <div class="mt-8 flex flex-wrap gap-2">
            {filters.map((f, idx) => (
              <button class={`btn btn-sm rounded-box ${idx === 0 ? 'btn-primary' : 'btn-outline'}`}>
                {f}
              </button>
            ))}
          </div>
        </div>

        <div class="aspect-21/9 rounded-box overflow-hidden bg-base-300 border border-base-300 shadow-md relative group mb-14">
          <div class="flex h-full w-full items-center justify-center bg-base-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-20 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
            </svg>
          </div>
          <div class="absolute bottom-0 inset-x-0 p-6 bg-gradient-to-t from-black/80 to-transparent text-white flex items-end justify-between">
            <div>
              <span class="badge badge-primary badge-xs font-semibold uppercase">{items[0]?.category}</span>
              <h3 class="text-xl font-bold mt-1 text-white">{items[0]?.title}</h3>
              <p class="text-xs text-white/80 mt-1">{items[0]?.client} • {items[0]?.year}</p>
            </div>
            <a href={items[0]?.link || "#"} class="btn btn-primary btn-sm">Case Study</a>
          </div>
        </div>
      </div>
    )}

    {layout === 'grid' && (
      <div>
        <div class="mb-12">
          {tagline && <span class="badge badge-primary badge-sm font-semibold mb-2">{tagline}</span>}
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{heading}</h2>
          {subtext && <p class="mt-2 text-sm opacity-70 max-w-2xl">{subtext}</p>}
        </div>

        <div class={`grid gap-8 ${cols === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'}`}>
          {items.map((project) => (
            <div class="group flex flex-col justify-between">
              <div>
                <div class="aspect-4/3 rounded-box overflow-hidden bg-base-300 border border-base-300 relative shadow-sm">
                  <div class="flex h-full w-full items-center justify-center bg-base-200 transition-transform duration-300 group-hover:scale-105">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-12 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
                    </svg>
                  </div>
                </div>

                <div class="mt-4 flex items-center justify-between text-xs opacity-60">
                  <span>{project.category}</span>
                  {project.client && <span>{project.client} • {project.year}</span>}
                </div>

                <h3 class="mt-1 text-lg font-bold group-hover:text-primary transition-colors">
                  {project.title}
                </h3>
                {project.description && <p class="mt-1 text-xs opacity-70 leading-relaxed">{project.description}</p>}
              </div>

              <div class="mt-4 pt-2">
                <a href={project.link || "#"} class="inline-flex items-center gap-1.5 text-xs font-bold text-primary">
                  View Project <span set:html={ARROW} />
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {layout === 'split' && (
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5 space-y-6">
          <span class="badge badge-primary badge-sm font-semibold">{items[0]?.category || "Case Study"}</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{items[0]?.title || "Enterprise Architecture"}</h2>
          <p class="text-sm opacity-70 leading-relaxed">{items[0]?.description || "Scalable design system with 1,524 reusable components in pure Astro."}</p>
          
          <div class="pt-2">
            <a href={items[0]?.link || "#"} class="btn btn-primary btn-sm">Explore Project</a>
          </div>
        </div>

        <div class="lg:col-span-7 aspect-16/10 rounded-box overflow-hidden bg-base-300 border border-base-300 shadow-sm flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-16 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
          </svg>
        </div>
      </div>
    )}
  </div>
</section>
