---
/**
 * DataTable — reproduces Relume's `tables` (10).
 *
 * Patterns supported:
 * 1. Responsive table wrapper with DaisyUI `table table-zebra table-pin-rows`.
 * 2. Rich table cells: User (avatar + name + handle/email), status badges, tags, metrics.
 * 3. Table header actions bar: search box, filter dropdown, export button.
 * 4. Table footer pagination: record summary, previous/next buttons.
 * 5. Tone: light | dark.
 *
 * Zero external JS; 100% semantic DaisyUI 5 tokens.
 */
interface TableRow {
  id: string | number;
  user: {
    name: string;
    email: string;
    avatar: string;
  };
  role: string;
  department: string;
  status: 'Active' | 'Pending' | 'Offline' | 'Suspended';
  lastActive: string;
  performance?: number;
}

interface Props {
  tone?: 'light' | 'dark';
  tagline?: string;
  heading?: string;
  subtext?: string;
  rows?: TableRow[];
}

const {
  tone = 'light',
  tagline = "Data Directory",
  heading = "Team Access & Permissions",
  subtext = "Manage users, access levels, and security posture across your organization.",
  rows = [
    {
      id: 1,
      user: {
        name: "Alex Morgan",
        email: "alex.morgan@company.io",
        avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80"
      },
      role: "Lead Architect",
      department: "Engineering",
      status: "Active",
      lastActive: "2 mins ago",
      performance: 98
    },
    {
      id: 2,
      user: {
        name: "Sarah Chen",
        email: "sarah.chen@company.io",
        avatar: "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=120&q=80"
      },
      role: "Senior Product Designer",
      department: "Design System",
      status: "Active",
      lastActive: "45 mins ago",
      performance: 94
    },
    {
      id: 3,
      user: {
        name: "Marcus Vance",
        email: "marcus.v@company.io",
        avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80"
      },
      role: "DevOps Engineer",
      department: "Infrastructure",
      status: "Pending",
      lastActive: "1 day ago",
      performance: 82
    },
    {
      id: 4,
      user: {
        name: "Elena Rostova",
        email: "elena.r@company.io",
        avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=120&q=80"
      },
      role: "Security Analyst",
      department: "Compliance",
      status: "Active",
      lastActive: "3 hours ago",
      performance: 99
    },
    {
      id: 5,
      user: {
        name: "David Kim",
        email: "david.kim@company.io",
        avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80"
      },
      role: "Frontend Engineer",
      department: "Engineering",
      status: "Offline",
      lastActive: "3 days ago",
      performance: 88
    }
  ]
} = Astro.props;

const dark = tone === 'dark';
---

<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        {tagline && (
          <span class="badge badge-sm badge-primary uppercase font-bold tracking-wider mb-2">
            {tagline}
          </span>
        )}
        <h2 class="text-3xl font-extrabold tracking-tight">
          {heading}
        </h2>
        {subtext && (
          <p class={`mt-1 text-sm ${dark ? 'text-neutral-content/70' : 'text-base-content/70'}`}>
            {subtext}
          </p>
        )}
      </div>

      <!-- Action Toolbar -->
      <div class="flex items-center gap-3">
        <label class="input input-sm input-bordered flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4 opacity-70">
            <path fill-rule="evenodd" d="M9.965 11.026a5 5 0 1 1 1.06-1.06l2.755 2.754a.75.75 0 1 1-1.06 1.06l-2.755-2.754ZM10.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" clip-rule="evenodd" />
          </svg>
          <input type="text" class="grow" placeholder="Search members..." />
        </label>
        <button class="btn btn-sm btn-primary">
          + Add Member
        </button>
      </div>
    </div>

    <!-- Table Container -->
    <div class={`border rounded-2xl overflow-hidden shadow-sm ${
      dark ? 'border-neutral-content/10 bg-neutral-content/5' : 'border-base-300 bg-base-100'
    }`}>
      <div class="overflow-x-auto">
        <table class="table table-zebra table-pin-rows w-full">
          <thead>
            <tr class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-200 text-base-content'}>
              <th class="w-12">
                <input type="checkbox" class="checkbox checkbox-xs" aria-label="Select all" />
              </th>
              <th>Member</th>
              <th>Role & Team</th>
              <th>Status</th>
              <th>Uptime / Perf</th>
              <th>Last Active</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="hover:bg-base-200/40 transition-colors">
                <td>
                  <input type="checkbox" class="checkbox checkbox-xs" aria-label={`Select ${row.user.name}`} />
                </td>
                <td>
                  <div class="flex items-center gap-3">
                    <div class="avatar">
                      <div class="mask mask-squircle size-10 bg-base-300">
                        <img src={row.user.avatar} alt={row.user.name} />
                      </div>
                    </div>
                    <div>
                      <div class="font-bold text-sm">{row.user.name}</div>
                      <div class="text-xs opacity-60">{row.user.email}</div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="text-sm font-semibold">{row.role}</div>
                  <div class="badge badge-sm badge-ghost mt-0.5">{row.department}</div>
                </td>
                <td>
                  <span class={`badge badge-sm font-medium ${
                    row.status === 'Active' ? 'badge-success gap-1' :
                    row.status === 'Pending' ? 'badge-warning gap-1' :
                    'badge-ghost'
                  }`}>
                    {row.status}
                  </span>
                </td>
                <td>
                  {row.performance && (
                    <div class="flex items-center gap-2">
                      <progress
                        class={`progress w-16 ${
                          row.performance >= 90 ? 'progress-success' : 'progress-primary'
                        }`}
                        value={row.performance}
                        max="100"
                      />
                      <span class="text-xs font-mono font-bold">{row.performance}%</span>
                    </div>
                  )}
                </td>
                <td class="text-xs opacity-70 whitespace-nowrap">
                  {row.lastActive}
                </td>
                <td class="text-right">
                  <div class="dropdown dropdown-end">
                    <button tabindex="0" class="btn btn-ghost btn-xs btn-circle" aria-label="Options">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                        <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM10 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM10 14a1.5 1.5 0 110 3 1.5 1.5 0 010-3z" />
                      </svg>
                    </button>
                    <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-base-100 rounded-box w-40 z-10 text-xs border border-base-300">
                      <li><a href="#edit">Edit Permissions</a></li>
                      <li><a href="#activity">View Activity Log</a></li>
                      <li><a href="#suspend" class="text-error">Suspend Access</a></li>
                    </ul>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Pagination Bar -->
      <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-base-300 gap-4 text-xs">
        <span class="opacity-70">
          Showing <span class="font-bold">1</span> to <span class="font-bold">{rows.length}</span> of <span class="font-bold">248</span> results
        </span>

        <div class="join">
          <button class="join-item btn btn-xs btn-outline">Previous</button>
          <button class="join-item btn btn-xs btn-active">1</button>
          <button class="join-item btn btn-xs btn-outline">2</button>
          <button class="join-item btn btn-xs btn-outline">3</button>
          <button class="join-item btn btn-xs btn-outline">Next</button>
        </div>
      </div>
    </div>
  </div>
</section>
