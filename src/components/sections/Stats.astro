---
/**
 * Stats — reproduces Relume's `stats-sections` (60) and `stat-cards` (8).
 *
 * Patterns supported:
 * 1. layout="band" — horizontal stats strip across the full width.
 * 2. layout="cards" — grid of 2, 3, or 4 elevated or bordered stat cards with icons.
 * 3. layout="split" — heading + descriptive copy left, 2x2 stats block right.
 *
 * Built with daisyUI `stats`, `stat`, `stat-value`, `stat-title`, `stat-desc`.
 * Zero-JS, 100% semantic colors.
 */
interface StatItem {
  value: string;
  label: string;
  desc?: string;
  icon?: string;
}

interface Props {
  layout?: 'band' | 'cards' | 'split';
  cols?: 2 | 3 | 4;
  tone?: 'light' | 'dark';
  heading?: string;
  subtext?: string;
  tagline?: string;
  items?: StatItem[];
}

const {
  layout = 'band',
  cols = 3,
  tone = 'light',
  heading,
  subtext,
  tagline,
  items = [
    { value: "99.99%", label: "Uptime SLA", desc: "Enterprise infrastructure" },
    { value: "10M+", label: "Active Users", desc: "Across 140 countries" },
    { value: "35+", label: "Built-in Themes", desc: "Instant zero-flash swap" },
    { value: "1,524", label: "Components", desc: "Pure Astro & DaisyUI" }
  ],
} = Astro.props;

const dark = tone === 'dark';
const DEFAULT_ICON = '<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>';
---

<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    {heading && layout !== 'split' && (
      <div class="text-center mb-12">
        {tagline && <p class="text-xs font-bold uppercase tracking-wider text-primary mb-2">{tagline}</p>}
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{heading}</h2>
        {subtext && <p class="mt-3 text-sm opacity-70 max-w-2xl mx-auto">{subtext}</p>}
      </div>
    )}

    {layout === 'band' && (
      <div class={`grid gap-8 text-center divide-y sm:divide-y-0 sm:divide-x ${
        dark ? 'divide-neutral-content/15' : 'divide-base-300'
      } ${items.length === 2 ? 'sm:grid-cols-2' : items.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3'}`}>
        {items.map((stat) => (
          <div class="pt-6 sm:pt-0 sm:px-6">
            <div class="text-4xl sm:text-5xl font-extrabold tracking-tight text-primary">{stat.value}</div>
            <div class="mt-2 text-base font-semibold">{stat.label}</div>
            {stat.desc && <p class="mt-1 text-xs opacity-60">{stat.desc}</p>}
          </div>
        ))}
      </div>
    )}

    {layout === 'cards' && (
      <div class={`grid gap-6 ${cols === 2 ? 'sm:grid-cols-2' : cols === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3'}`}>
        {items.map((stat) => (
          <div class={`rounded-box p-6 border ${
            dark ? 'border-neutral-content/15 bg-neutral-content/5' : 'border-base-300 bg-base-100 shadow-sm'
          }`}>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold uppercase tracking-wider opacity-70">{stat.label}</span>
              <span set:html={stat.icon || DEFAULT_ICON} />
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary">{stat.value}</div>
            {stat.desc && <p class="mt-2 text-xs opacity-60">{stat.desc}</p>}
          </div>
        ))}
      </div>
    )}

    {layout === 'split' && (
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5 space-y-4">
          {tagline && <span class="badge badge-primary badge-sm font-semibold">{tagline}</span>}
          <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{heading || "Proven scale for modern web development"}</h2>
          <p class="text-sm opacity-70 leading-relaxed">{subtext || "Built to handle enterprise volume with effortless customization and uncompromised performance."}</p>
        </div>

        <div class="lg:col-span-7 grid gap-6 sm:grid-cols-2">
          {items.map((stat) => (
            <div class={`rounded-box p-6 border ${
              dark ? 'border-neutral-content/15 bg-neutral-content/5' : 'border-base-300 bg-base-100 shadow-sm'
            }`}>
              <div class="text-3xl sm:text-4xl font-extrabold text-primary">{stat.value}</div>
              <div class="mt-2 font-bold text-sm">{stat.label}</div>
              {stat.desc && <p class="mt-1 text-xs opacity-60">{stat.desc}</p>}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
