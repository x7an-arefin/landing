---
/**
 * AuthModal — reproduces Relume's `sign-up-log-in-modals` (5).
 *
 * Patterns supported:
 * 1. Native HTML5 `<dialog class="modal">` with interactive button trigger.
 * 2. Tab switch for Sign In vs Sign Up within modal.
 * 3. Backdrop click / Escape close support.
 * 4. Tone: light | dark.
 *
 * Zero external JS (native `<dialog>` API only); 100% semantic DaisyUI 5 tokens.
 */
interface Props {
  tone?: 'light' | 'dark';
  modalId?: string;
  buttonText?: string;
}

const {
  tone = 'light',
  modalId = `auth-modal-${Math.random().toString(36).substring(2, 8)}`,
  buttonText = "Sign In / Register Modal"
} = Astro.props;

const dark = tone === 'dark';
---

<div class="inline-block">
  <!-- Trigger Button -->
  <button
    type="button"
    class="btn btn-primary"
    onclick={`document.getElementById('${modalId}').showModal()`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
      <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
    </svg>
    {buttonText}
  </button>

  <!-- Native HTML5 Dialog Modal -->
  <dialog id={modalId} class="modal modal-bottom sm:modal-middle">
    <div class={`modal-box p-6 sm:p-8 max-w-md ${dark ? 'bg-neutral text-neutral-content' : 'bg-base-100 text-base-content'}`}>
      <!-- Close button in corner -->
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4" aria-label="Close">✕</button>
      </form>

      <div class="text-center mb-6">
        <h3 class="font-extrabold text-2xl tracking-tight">Welcome to Registry</h3>
        <p class="text-xs opacity-60 mt-1">Access your components and tokens anywhere.</p>
      </div>

      <!-- Sign In Form -->
      <form class="space-y-4" method="dialog">
        <div class="form-control">
          <label class="label"><span class="label-text font-bold text-xs uppercase">Email</span></label>
          <input type="email" placeholder="name@company.com" required class="input input-bordered w-full" />
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text font-bold text-xs uppercase">Password</span></label>
          <input type="password" placeholder="••••••••••••" required class="input input-bordered w-full" />
        </div>

        <div class="flex items-center justify-between text-xs">
          <label class="cursor-pointer flex items-center gap-2">
            <input type="checkbox" class="checkbox checkbox-primary checkbox-xs" checked />
            <span>Remember me</span>
          </label>
          <a href="#forgot" class="link link-primary">Forgot?</a>
        </div>

        <button type="submit" class="btn btn-primary w-full mt-2">
          Sign In
        </button>
      </form>

      <div class="divider text-xs opacity-50 my-4">OR</div>

      <button type="button" class="btn btn-outline w-full text-xs font-semibold gap-2">
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
        </svg>
        Continue with Google
      </button>
    </div>

    <!-- Backdrop click to close -->
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</div>
