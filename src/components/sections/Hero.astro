---
/**
 * Hero — reproduces Relume's `hero-header-sections` (55) and
 * `hero-header-sections-grid-cards` (18, via contained=true).
 *
 * Verified against live previews 2026-09-21: all static (no video/inputs in
 * the reference DOM — the "video" look is a placeholder block + play glyph).
 *
 * Families covered (see docs/components-map.md → hero-header-sections):
 *  - split hero: text (start) + media right/left — media = image or
 *    video-placeholder (rounded optional), bg light or dark full-bleed
 *  - centered hero: centered title + text + buttons or e-mail capture
 *  - media-below: title/text + wide media under the text (headers 71–74, 150)
 *  - media-forward: big centered media (header 13)
 *  - long-heading variant (headers 40–43, 145–152) = same anatomy, longer copy
 *  - grid-cards: identical anatomy inside a contained card panel (84–101)
 *
 * Zero JS, semantic colors only (dark tone = bg-neutral + neutral-content).
 */
export interface HeroMedia {
  kind?: 'image' | 'video';
  side?: 'right' | 'left' | 'below' | 'center';
  src?: string;
}
interface Props {
  align?: 'start' | 'center';
  tone?: 'light' | 'dark';
  /** hero-header-sections-grid-cards: hero lives inside an inset card panel */
  contained?: boolean;
  media?: HeroMedia | false;
  capture?: 'buttons' | 'email' | 'none';
  /** fine-print line under the capture (e.g. "By signing up you agree…") */
  note?: string;
  title?: string;
  text?: string;
}
const {
  align = 'start',
  tone = 'light',
  contained = false,
  media,
  capture = 'buttons',
  note,
  title = 'Medium length hero heading goes here',
  text = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat.',
} = Astro.props;

const centered = align === 'center';
const mediaSide = media?.side ?? (centered ? 'center' : 'right');
const mediaBelow = mediaSide === 'below' || mediaSide === 'center';
const mediaRight = mediaSide === 'right';
const mediaLeft = mediaSide === 'left';
const dark = tone === 'dark';
const mediaBg = dark ? 'bg-neutral-content/10' : 'bg-base-300';

const PHOTO = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-10 opacity-30"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>';
const PLAY = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 translate-x-0.5"><path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14Z" /></svg>';
---
<section class={dark ? 'bg-neutral text-neutral-content' : 'bg-base-100'}>
  <div class={contained ? 'mx-auto max-w-7xl px-4 py-12' : ''}>
    <div class={
      contained
        ? `${dark ? 'bg-neutral text-neutral-content border-neutral-content/15' : 'bg-base-100 border-base-300'} rounded-box p-10`
        : ''
    }>
      <div class={contained ? '' : 'mx-auto max-w-7xl px-4 py-16'}>
        <div class={mediaBelow || !media ? '' : 'grid items-center gap-10 lg:grid-cols-2'}>
          <!-- Text column -->
          <div class={centered ? 'text-center mx-auto max-w-2xl' : mediaLeft ? 'order-2' : ''}>
            <h1 class={`text-4xl md:text-5xl font-extrabold tracking-tight ${centered ? '' : 'max-w-xl'}`}>{title}</h1>
            <p class={`mt-4 opacity-75 ${centered ? 'mx-auto' : 'max-w-lg'}`}>{text}</p>

            {capture === 'buttons' && (
              <div class={`flex gap-3 mt-8 ${centered ? 'justify-center' : ''}`}>
                <button class={`btn ${dark ? 'btn-neutral bg-base-100 text-base-content' : 'btn-neutral'}`}>Button</button>
                <button class="btn btn-outline">Button</button>
              </div>
            )}
            {capture === 'email' && (
              <div class={centered ? 'mt-8 flex justify-center' : 'mt-8'}>
                <form class="join">
                  <input type="email" placeholder="Enter your email" class={`input input-bordered join-item w-64 ${dark ? 'bg-transparent' : ''}`} />
                  <button class="btn join-item btn-neutral">{note ? 'Sign Up' : 'Subscribe'}</button>
                </form>
              </div>
            )}
            {note && <p class={`mt-3 text-xs opacity-50 ${centered ? 'mx-auto' : 'max-w-md'}`}>{note}</p>}
          </div>

          <!-- Media column (side by side) -->
          {media && !mediaBelow && (
            <div class={mediaLeft ? 'order-1' : ''}>
              {media.kind === 'video' ? (
                <div class={`relative aspect-[4/3] ${mediaBg} flex items-center justify-center`}>
                  {media.src ? <video src={media.src} class="w-full h-full object-cover" muted playsinline preload="metadata" /> : null}
                  <span class="absolute size-14 rounded-full bg-base-100/90 text-base-content shadow-lg flex items-center justify-center" set:html={PLAY} />
                </div>
              ) : (
                <div class={`aspect-[4/3] ${mediaBg} flex items-center justify-center`}>
                  {media.src
                    ? <img src={media.src} alt="" class="w-full h-full object-cover" />
                    : <span set:html={PHOTO} />}
                </div>
              )}
            </div>
          )}
        </div>

        <!-- Media below / centered-forward -->
        {media && mediaBelow && (
          <div class={`mt-10 ${centered ? 'mx-auto max-w-3xl' : ''}`}>
            {media.kind === 'video' ? (
              <div class={`relative aspect-[16/7] ${mediaBg} flex items-center justify-center`}>
                {media.src ? <video src={media.src} class="w-full h-full object-cover" muted playsinline preload="metadata" /> : null}
                <span class="absolute size-14 rounded-full bg-base-100/90 text-base-content shadow-lg flex items-center justify-center" set:html={PLAY} />
              </div>
            ) : (
              <div class={`aspect-[16/7] ${mediaBg} flex items-center justify-center`}>
                {media.src ? <img src={media.src} alt="" class="w-full h-full object-cover" /> : <span set:html={PHOTO} />}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
</section>
