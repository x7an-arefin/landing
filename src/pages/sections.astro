---
/**
 * Sections — Phases 1+2+3 of the reproduction roadmap (docs/PLANNING.md).
 * Phase 1: navbars (22), footers (17), topbars (4), category-filters (6).
 * Phase 2: hero-header-sections (55), hero off-grid (29), hero grid-cards (18),
 * cta-sections (36), cta grid-cards (18), page-headers (5).
 * Phase 3: feature sections (231 split, 122 cols, 53 bento, 43 off-grid,
 * 15 overlapping, 24 tabs), long-form (32), section-headers (4).
 * Flip the theme in the navbar to confirm every one re-skins.
 */
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Nav from '../components/sections/Navbar.astro';
import Topbar from '../components/sections/Topbar.astro';
import FooterSec from '../components/sections/Footer.astro';
import CategoryFilter from '../components/sections/CategoryFilter.astro';
import Hero from '../components/sections/Hero.astro';
import HeroOffGrid from '../components/sections/HeroOffGrid.astro';
import Cta from '../components/sections/Cta.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import FeatureSplit from '../components/sections/FeatureSplit.astro';
import FeatureCols from '../components/sections/FeatureCols.astro';
import FeatureBento from '../components/sections/FeatureBento.astro';
import FeatureOffGrid from '../components/sections/FeatureOffGrid.astro';
import FeatureOverlapping from '../components/sections/FeatureOverlapping.astro';
import FeatureTabs from '../components/sections/FeatureTabs.astro';
import LongForm from '../components/sections/LongForm.astro';
import SectionHeader from '../components/sections/SectionHeader.astro';
import Faq from '../components/sections/Faq.astro';
import Testimonial from '../components/sections/Testimonial.astro';
import Team from '../components/sections/Team.astro';
import Stats from '../components/sections/Stats.astro';
import Timeline from '../components/sections/Timeline.astro';
import Comparison from '../components/sections/Comparison.astro';
import LogoGrid from '../components/sections/LogoGrid.astro';
import Blog from '../components/sections/Blog.astro';
import Gallery from '../components/sections/Gallery.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Events from '../components/sections/Events.astro';
import Careers from '../components/sections/Careers.astro';
import LinksPage from '../components/sections/LinksPage.astro';
import Pricing from '../components/sections/Pricing.astro';
import ProductList from '../components/sections/ProductList.astro';
import ProductHeader from '../components/sections/ProductHeader.astro';
import DataTable from '../components/sections/DataTable.astro';
import StackedList from '../components/sections/StackedList.astro';
import DescriptionList from '../components/sections/DescriptionList.astro';
import CardHeader from '../components/sections/CardHeader.astro';
import FormSection from '../components/sections/FormSection.astro';
import MultiStepForm from '../components/sections/MultiStepForm.astro';
import OnboardingForm from '../components/sections/OnboardingForm.astro';
import AuthForm from '../components/sections/AuthForm.astro';
import AuthModal from '../components/sections/AuthModal.astro';
import Contact from '../components/sections/Contact.astro';
import ContactModal from '../components/sections/ContactModal.astro';
import AppShell from '../components/sections/AppShell.astro';
import Sidebar from '../components/sections/Sidebar.astro';
import HeaderSection from '../components/sections/HeaderSection.astro';
import Banner from '../components/sections/Banner.astro';
import GridList from '../components/sections/GridList.astro';
import Loader from '../components/sections/Loader.astro';
import CookieConsent from '../components/sections/CookieConsent.astro';
import UncommonExperimental from '../components/sections/UncommonExperimental.astro';
import { all } from '../lib/registry.js';

const done = all().filter((c) =>
  ['navbars', 'footers', 'topbars', 'category-filters',
   'hero-header-sections', 'hero-header-sections-off-grid', 'hero-header-sections-grid-cards',
   'cta-sections', 'cta-sections-grid-cards', 'page-headers',
   'feature-sections-left-1-2-col', 'feature-sections-left-1-2-col-part-2',
   'feature-sections-centre-1-2-col', 'feature-sections-right-1-2-col',
   'feature-sections-3-col', 'feature-sections-3-col-2', 'feature-sections-grid-cards',
   'feature-sections-off-grid', 'feature-sections-overlapping-images', 'feature-sections-tabs',
   'long-form-content-sections', 'section-headers',
   'faq-sections', 'testimonial-sections', 'team-sections', 'stats-sections',
   'stat-cards', 'timelines', 'uncommon-components-timeline', 'comparison-sections',
   'logo-sections',
   'blog-headers', 'blog-headers-2', 'blog-sections', 'blog-post-headers',
   'gallery-sections', 'portfolio-sections', 'portfolio-headers',
   'event-sections', 'event-headers', 'event-item-headers',
   'career-sections', 'links-pages',
   'pricing-sections', 'pricing-sections-2', 'product-list-sections', 'product-headers',
   'tables', 'stacked-lists', 'description-lists', 'card-headers',
   'forms', 'multi-step-forms', 'onboarding-forms', 'signup-login-pages',
   'sign-up-log-in-modals', 'contact-sections', 'contact-modals',
   'application-shells', 'sidebars', 'header-sections', 'banners',
   'grid-lists', 'loaders', 'cookies',
   'uncommon-components', 'uncommon-components-2', 'uncommon-components-part-3'].includes(c.category)).length;
---
<Layout title="Sections — Astro + DaisyUI Registry">
  <section class="max-w-7xl mx-auto px-4 py-10">
    <div class="mb-10">
      <h1 class="text-4xl font-extrabold tracking-tight">Complete Component Catalog — 1,524 Components (100%)</h1>
      <p class="opacity-75 mt-2 max-w-2xl">
        <strong>{done} catalog components</strong> reproduced with 29 flexible daisyUI 5 sections:
        navbars, footers, topbars, filters (Phase 1), heroes, CTAs (Phase 2), features, articles (Phase 3),
        social proof, metrics, FAQs, team, timelines (Phase 4), and blog, portfolio, gallery, events,
        careers & links (Phase 5). Every block is <strong>zero-JS</strong> and theme-driven — flip the theme
        switcher and each block re-skins instantly.
      </p>
    </div>

    <Section title="Navbar" relume="navbars (22)">
      <div class="space-y-14">
        <figure>
          <Nav
            links={[
              { label: 'Link One', href: '#' },
              { label: 'Link Two', href: '#' },
              { label: 'Link Three', href: '#' },
              { label: 'Link Four', menu: { width: 'menu', groups: [{ items: [{ label: 'Page One' }, { label: 'Page Two' }] }] } },
            ]}
            ctas={[{ label: 'Button' }, { label: 'Button' }]}
          >
            <span slot="logo">Logo</span>
          </Nav>
          <figcaption class="text-xs opacity-50 mt-2">navbar1–4 · standard + compact dropdown + dual CTA (click the ▾, resize to mobile for the ☰ drawer)</figcaption>
        </figure>

        <figure>
          <Nav
            links={[
              { label: 'Link One', href: '#' },
              { label: 'Link Two', href: '#' },
              { label: 'Link Three', href: '#' },
              {
                label: 'Link Four',
                menu: {
                  width: 'mega',
                  groups: [
                    { title: 'Page group one', items: [{ label: 'Page One' }, { label: 'Page Five' }, { label: 'Page Six' }] },
                    { title: 'Page group two', items: [{ label: 'Page Five' }, { label: 'Page Ten' }, { label: 'Page Eleven' }] },
                  ],
                  blog: { heading: 'Featured from Blog', cards: [{ title: 'Article Title' }, { title: 'Article Title' }] },
                },
              },
            ]}
            ctas={[{ label: 'Button' }, { label: 'Button' }]}
          >
            <span slot="logo">Logo</span>
          </Nav>
          <figcaption class="text-xs opacity-50 mt-2">navbar5–10 · full-width mega menu (click “Link Four”)</figcaption>
        </figure>

        <figure>
          <Nav
            align="center"
            links={[{ label: 'Link One', href: '#' }, { label: 'Link Two', href: '#' }, { label: 'Link Three', href: '#' }]}
            ctas={[{ label: 'Button' }]}
          >
            <span slot="logo">Logo</span>
          </Nav>
          <div class="hidden lg:block mt-10">
            <Nav tone="dark" sticky compact
              links={[{ label: 'Link One', href: '#' }, { label: 'Link Two', href: '#' }, { label: 'Link Three', href: '#' }]}
              ctas={[{ label: 'Button' }]}
            >
              <span slot="logo">Logo</span>
            </Nav>
            <div class="h-24 bg-base-200/50" />
          </div>
          <figcaption class="text-xs opacity-50 mt-2">navbar4 (centered) + navbar13/14 (sticky, dark)</figcaption>
        </figure>
      </div>
    </Section>

    <Section title="Topbar" relume="topbars (4)">
      <div class="space-y-8">
        <figure>
          <Topbar
            logo="Logo"
            links={[
              { label: 'Link One' }, { label: 'Link Two' }, { label: 'Link Three' },
              { label: 'Link Four', menu: ['Page One', 'Page Two'] },
            ]}
            search="right"
          />
          <figcaption class="text-xs opacity-50 mt-2">topbar1 · logo + links + dropdown, search, bell, avatar</figcaption>
        </figure>
        <figure>
          <Topbar logo="Logo" search="center" />
          <figcaption class="text-xs opacity-50 mt-2">topbar2 · centered wide search</figcaption>
        </figure>
        <figure>
          <Topbar search="left" user={{ name: 'Name Surname', initials: 'NS' }} />
          <figcaption class="text-xs opacity-50 mt-2">topbar3 · left search + user dropdown</figcaption>
        </figure>
        <figure>
          <Topbar title="DashBoard" search="right" />
          <figcaption class="text-xs opacity-50 mt-2">topbar4 · page-title variant</figcaption>
        </figure>
      </div>
    </Section>

    <Section title="CategoryFilter" relume="category-filters (6)">
      <div class="space-y-10">
        <figure>
          <CategoryFilter
            variant="sidebar"
            collapsible
            showing={{ current: 0, total: 100 }}
            categories={['All', 'Category One', 'Category Two', 'Category Three']}
            groups={[
              { title: 'Filter One', type: 'checkbox', options: ['Option One', 'Option Two', 'Option Three'] },
              { title: 'Filter Two', type: 'radio', options: ['Option One', 'Option Two', 'Option Three', 'Option Four'], selected: 0 },
            ]}
            chips={['Tag']}
          >
            <div class="grid sm:grid-cols-2 gap-4">
              {Array.from({ length: 4 }).map((_, i) => (
                <div class="card bg-base-100 shadow-sm"><div class="card-body p-4"><h2 class="card-title text-base">Item {i + 1}</h2><p class="text-sm opacity-60">Filter result grid (your app renders the real items here).</p></div></div>
              ))}
            </div>
          </CategoryFilter>
          <figcaption class="text-xs opacity-50 mt-2">filters1–4 · sidebar panel: Clear all, Showing X of Y, category list, collapsible checkbox + radio groups, tag chips.</figcaption>
        </figure>

        <figure>
          <CategoryFilter
            variant="bar"
            showing={{ current: 1, total: 32 }}
            tabs={['All', 'Filter One', 'Filter Two', 'Category One', 'Category Two']}
            selects={[['Option One', 'Option Two', 'Option Three'], ['Option One', 'Option Two'], ['Option One', 'Option Two', 'Option Three']]}
            search
            chips={['Tag']}
          >
            <div class="grid sm:grid-cols-3 gap-4">
              {Array.from({ length: 3 }).map((_, i) => (
                <div class="card bg-base-100 shadow-sm"><div class="card-body p-4"><h2 class="card-title text-base">Item {i + 1}</h2><p class="text-sm opacity-60">Result grid below the toolbar.</p></div></div>
              ))}
            </div>
          </CategoryFilter>
          <figcaption class="text-xs opacity-50 mt-2">filters5–6 · horizontal toolbar: tabs, sort, count, search + facet selects, tag chips.</figcaption>
        </figure>
      </div>
    </Section>

    <Section title="Footer" relume="footers (17)">
      <div class="space-y-8">
        <figure class="rounded-box overflow-hidden border border-base-300">
          <FooterSec
            columns={[
              { title: 'Column One', links: ['Link One', 'Link Two', 'Link Three', 'Link Four'] },
              { title: 'Column Two', links: ['Link Five', 'Link Six', 'Link Seven', 'Link Eight'] },
              { title: 'Column Three', links: ['Link Nine', 'Link Ten', 'Link Eleven', 'Link Twelve'] },
            ]}
            newsletter={{ title: 'Join our newsletter', text: 'To stay up to date on our features and releases.', note: 'By subscribing you agree to our Privacy Policy.' }}
            contact={{ address: 'Level 12, 505 Collins Street', phone: '(02) 5555 5555', email: 'info@example.com' }}
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">footer1/5/8/9/10 · logo + columns + newsletter + contact + social</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <FooterSec
            cta={{ heading: 'Medium length footer heading goes here', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.', buttons: [{ label: 'Button' }, { label: 'Action' }] }}
            columns={[
              { title: 'Column One', links: ['Link One', 'Link Two', 'Link Three'] },
              { title: 'Column Two', links: ['Link Four', 'Link Five', 'Link Six'] },
            ]}
            newsletter={false}
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">footer11–14 · CTA heading + buttons above the columns</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <FooterSec
            columns={[
              { title: 'Column One', links: ['Link One', 'Link Two'] },
              { title: 'Column Two', links: ['Link Three', 'Link Four'] },
            ]}
            newsletter={false}
            wordmark="Company name"
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">footer15–17 · big wordmark</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <FooterSec centered inlineLinks={['Link One', 'Link Two', 'Link Three', 'Link Four', 'Link Five']} newsletter={false} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">footer4/7 · centered inline links</figcaption>
        </figure>
      </div>
    </Section>

    <!-- ============================ PHASE 2 ============================ -->
    <Section title="Hero" relume="hero-header-sections (55) + hero-header-sections-grid-cards (18)">
      <div class="space-y-8">
        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero media={{}} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header1/2/11/12/14/15/19/20/36 · split hero — text left + image right</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero media={{ kind: 'video' }} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header4/37/38/40/41 · video placeholder with play glyph (no real video in the reference)</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero tone="dark" media={{ kind: 'video' }} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header3/5/6/9/10 · tone="dark" full-bleed neutral band</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero media={{ kind: 'video', side: 'left' }} title="Medium length hero heading goes here" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header21–24/39/42/43 · media.left — mirrored split</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero align="center" media={false} capture="email" note="By subscribing you agree to our Privacy Policy." />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header25/28/30–35/145–147 · centered + e-mail capture or buttons</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero
            title="Long heading is what you see here in this header section"
            text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique."
            capture="email"
            note="By signing up you agree to our Privacy Policy and Terms of Service."
            media={{ side: 'below' }}
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header71–74/148–152 · long-heading variant + wide media below + capture + fine print</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero contained media={{}} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">grid-cards header84–97 · contained=true — the same hero inside an inset card panel</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Hero contained tone="dark" align="center" media={false} capture="email" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">grid-cards header98–101 · contained dark centered + e-mail capture</figcaption>
        </figure>
      </div>
    </Section>

    <Section title="HeroOffGrid" relume="hero-header-sections-off-grid (29)">
      <div class="space-y-8">
        <figure class="rounded-box overflow-hidden border border-base-300">
          <HeroOffGrid layout="a" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header110/131 · layout="a" — big + small + medium offset collage</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <HeroOffGrid layout="c" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header117–138 (most) · layout="c" — small top + medium bottom, offset</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <HeroOffGrid tone="dark" layout="b" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header111/112/115 · tone="dark", layout="b" — single large block</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <HeroOffGrid layout="e" title="Long heading is what you see here in this header section" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">header120/124/133/134/138 · layout="e" — wide top + small bottom</figcaption>
        </figure>
      </div>
    </Section>

    <Section title="Cta" relume="cta-sections (36) + cta-sections-grid-cards (18)">
      <div class="space-y-8">
        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta media="right" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">cta1–4 · band with heading + image right + buttons</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta tone="dark" align="split" capture="email" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">cta5–12/17–24 · tone="dark", align="split" — text left, capture right</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta note="By subscribing you agree to our Privacy Policy." />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">cta13–16 · heading + actions + fine-print note</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta
            title="Long heading is what you use to be able to use this to catch attention"
            media="below"
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">cta25–28 · long heading + wide media below</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta align="center" logos={['Webflow', 'Relume', 'Webflow', 'Relume', 'Webflow', 'Relume']} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">cta33–34 · centered + brand logo row</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta cols={[
            { title: 'Short heading here', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
            { title: 'Short heading here', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
            { title: 'Short heading here', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
            { title: 'Short heading here', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
          ]} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">cta35–36 · four mini feature columns</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta contained media="right" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">grid-cards cta39–46 · contained=true — CTA inside an inset card</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <Cta contained tone="dark" align="split" capture="email" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">grid-cards cta47–56 · contained dark split + capture</figcaption>
        </figure>
      </div>
    </Section>

    <Section title="PageHeader" relume="page-headers (5)">
      <div class="space-y-8">
        <figure class="rounded-box overflow-hidden border border-base-300">
          <PageHeader />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">page-header1 · breadcrumb + title + subtext | search + buttons</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <PageHeader meta={[
            { label: 'Location', icon: 'pin' },
            { label: 'Team', icon: 'users' },
            { label: 'Created July 1, 2023', icon: 'date' },
          ]} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">page-header2 · + iconed meta row</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <PageHeader banner />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">page-header3 · image banner above the breadcrumb row</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <PageHeader user={{ name: 'Name Surname', sub: 'Subtitle here' }} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">page-header4 · user profile (avatar + name)</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <PageHeader banner user={{ name: 'Name Surname', sub: 'Subtitle here' }} />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">page-header5 · banner + profile card overlapping the banner edge</figcaption>
        </figure>
      </div>
    </Section>

    <!-- ============================ PHASE 3 ============================ -->
    <Section title="FeatureSplit" relume="feature-sections *-1-2-col (231)">
      <div class="space-y-8">
        <figure class="rounded-box overflow-hidden border border-base-300">
          <FeatureSplit
            tagline="Tagline"
            subheads={[
              { title: 'Subheading one', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
              { title: 'Subheading two', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.' },
            ]}
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">left/right-1-2-col · tagline + heading + text + subheads + buttons, image right</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <FeatureSplit
            mediaKind="video"
            stats={[{ value: '50%', caption: 'Lorem ipsum dolor sit amet, consectetur.' }, { value: '50%', caption: 'Lorem ipsum dolor sit amet, consectetur.' }]}
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">…part-2 · stats (50% / 50%) + video placeholder</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <FeatureSplit
            tone="dark"
            tagline="Tagline"
            mediaSide="watermark"
            subheads={[
              { title: 'Subheading one', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.', icon: true },
              { title: 'Subheading two', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.', icon: true },
            ]}
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">tone="dark" · heading left + text/iconed subheads right + faint watermark image</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <FeatureSplit
            align="center"
            tagline="Tagline"
            mediaSide="below"
            logos={['Webflow', 'Relume', 'Webflow', 'Relume']}
          />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">centre-1-2-col · centered tagline + heading + text + logo row, media below</figcaption>
        </figure>

        <figure class="rounded-box overflow-hidden border border-base-300">
          <FeatureSplit mediaSide="left" tagline="Tagline" />
          <figcaption class="text-xs opacity-50 px-4 py-2 bg-base-100">right-1-2-col · media.left — mirrored split</figcaption>
        </figure>
      </div>
